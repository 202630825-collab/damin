<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>우산 챙기기 알림 앱 ☂️</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Pretendard Font -->
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Pretendard', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Pretendard', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .rain-bg {
            background-image: radial-gradient(#3b82f6 1.2px, transparent 1.2px);
            background-size: 24px 24px;
            background-color: #f8fafc;
        }
        @keyframes pulse-subtle {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .pulse-subtle {
            animation: pulse-subtle 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-sky-100 min-h-screen text-slate-800 pb-12 rain-bg">

    <div class="max-w-md mx-auto px-4 pt-8">

        <!-- App Main Header -->
        <header class="text-center mb-6">
            <div class="inline-flex items-center justify-center p-3.5 bg-blue-600 text-white rounded-3xl shadow-lg shadow-blue-500/30 mb-3 pulse-subtle">
                <span class="text-4xl">☔</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">우산 챙기기 알림이</h1>
            <p class="text-xs text-slate-500 mt-1">비 오는 날 하교 시간에 우산을 집에 꼭 챙겨가세요!</p>
        </header>

        <!-- Notification Permission Status Banner -->
        <div id="notif-banner" class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-between shadow-sm transition-all duration-300">
            <div class="flex items-center gap-3">
                <span class="text-2xl">🔔</span>
                <div class="text-xs">
                    <p class="font-bold text-slate-800" id="notif-status-title">알림 권한 설정 필요</p>
                    <p class="text-slate-600" id="notif-status-desc">정확한 시간에 우산 알림을 받으려면 동의가 필요합니다.</p>
                </div>
            </div>
            <button id="notif-btn" onclick="requestNotificationPermission()" class="px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-xl shadow transition shrink-0">
                권한 허용
            </button>
        </div>

        <!-- VIEW 1: 7-Day Weather Setup Screen -->
        <section id="view-setup" class="hidden">
            <div class="glass-card rounded-3xl p-6 shadow-xl border border-white/60 mb-6">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <span>🗓️</span> 7일간 날씨 설정
                    </h2>
                    <span class="text-[11px] bg-blue-100 text-blue-700 font-bold px-2.5 py-1 rounded-full">오늘부터 7일</span>
                </div>
                <p class="text-xs text-slate-500 mb-5 leading-relaxed">
                    각 날짜에 비 소식이 있는지 눌러서 설정해주세요.<br>설정에 맞춰 <b>등교/하교 알림</b>이 자동 예약됩니다.
                </p>

                <!-- Weather Input List -->
                <div id="weather-input-list" class="space-y-3">
                    <!-- Dynamic rendering by JS -->
                </div>

                <button onclick="saveWeatherSchedule()" class="w-full mt-6 py-4 bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white font-bold rounded-2xl shadow-lg shadow-blue-500/25 transition duration-200 flex items-center justify-center gap-2">
                    <span>설정 완료 및 알림 시작</span>
                    <span>✨</span>
                </button>
            </div>
        </section>

        <!-- VIEW 2: Main Dashboard View -->
        <section id="view-dashboard" class="hidden space-y-5">
            
            <!-- Today Status Card -->
            <div id="today-card" class="rounded-3xl p-6 shadow-xl text-white transition-all duration-300 bg-gradient-to-r from-blue-600 to-indigo-700 relative overflow-hidden">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-[10px] uppercase tracking-wider font-bold bg-white/20 px-2 py-0.5 rounded-full" id="today-date-text">TODAY</span>
                        <h2 class="text-2xl font-bold mt-2" id="today-weather-title">오늘 날씨 확인 중...</h2>
                    </div>
                    <span id="today-weather-icon" class="text-5xl drop-shadow-md">☔</span>
                </div>
                
                <div class="mt-5 pt-4 border-t border-white/20 text-xs opacity-95 space-y-2" id="today-notif-schedule">
                    <!-- Dynamic Schedule for Today -->
                </div>
            </div>

            <!-- Schedule List for 7 Days -->
            <div class="glass-card rounded-3xl p-6 shadow-xl border border-white/60">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 flex items-center gap-2 text-sm">
                        <span>📅</span> 이번 주 비 알림 일정
                    </h3>
                    <button onclick="showSetupView()" class="text-xs text-blue-600 font-bold hover:text-blue-800 flex items-center gap-1 transition">
                        <span>✏️ 날씨 수정</span>
                    </button>
                </div>
                <div id="dashboard-schedule-list" class="space-y-2">
                    <!-- Dynamic Schedule List by JS -->
                </div>
            </div>

            <!-- School Bell Schedule Rules Info Box -->
            <div class="bg-white/80 backdrop-blur-md rounded-2xl p-4 text-xs text-slate-600 space-y-2 border border-slate-200 shadow-sm">
                <p class="font-bold text-slate-800 flex items-center gap-1.5">
                    <span>🔔</span> 요일별 하교 알림 시간
                </p>
                <div class="grid grid-cols-2 gap-2 text-[11px] pt-1">
                    <div class="bg-blue-50/80 p-2.5 rounded-xl border border-blue-100">
                        <p class="font-bold text-blue-800">월 / 목 / 금 (6교시)</p>
                        <p class="text-slate-500 mt-0.5">오후 <b>03:00</b> (15:00) 알림</p>
                    </div>
                    <div class="bg-indigo-50/80 p-2.5 rounded-xl border border-indigo-100">
                        <p class="font-bold text-indigo-800">화 / 수 (7교시)</p>
                        <p class="text-slate-500 mt-0.5">오후 <b>04:00</b> (16:00) 알림</p>
                    </div>
                </div>
                <p class="text-[10px] text-slate-400 pt-1">* 비 오는 날 아침 <b>08:00</b> 등교 알림도 기본 발송됩니다.</p>
            </div>

            <!-- Simulation & Test Notification Buttons -->
            <div class="pt-1 grid grid-cols-2 gap-2">
                <button onclick="testNotification('morning')" class="py-3 bg-slate-800 hover:bg-slate-900 active:scale-[0.98] text-white text-xs font-semibold rounded-2xl shadow transition flex items-center justify-center gap-1.5">
                    <span>🧪 등교 알림 테스트</span>
                </button>
                <button onclick="testNotification('afternoon')" class="py-3 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white text-xs font-semibold rounded-2xl shadow transition flex items-center justify-center gap-1.5">
                    <span>🧪 하교 알림 테스트</span>
                </button>
            </div>
        </section>

        <!-- Custom Toast Modal for Feedback -->
        <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/90 backdrop-blur-md text-white text-xs font-medium px-4 py-3 rounded-2xl shadow-2xl transition-all duration-300 opacity-0 pointer-events-none z-50 flex items-center gap-2 max-w-[90%] border border-slate-700">
            <span id="toast-icon">ℹ️</span>
            <span id="toast-msg">메시지 내용</span>
        </div>
    </div>

    <script>
        const DAY_NAMES = ['일', '월', '화', '수', '목', '금', '토'];

        // App State
        let weatherData = []; 

        window.addEventListener('DOMContentLoaded', () => {
            checkNotificationStatus();
            loadSavedData();
            startNotificationScheduler();
        });

        // Request browser Notification Permission
        function requestNotificationPermission() {
            if (!("Notification" in window)) {
                showToast("이 브라우저는 웹 알림을 지원하지 않습니다.", "⚠️");
                return;
            }

            Notification.requestPermission().then(permission => {
                checkNotificationStatus();
                if (permission === "granted") {
                    showToast("알림 권한이 허용되었습니다! ☂️", "✅");
                } else if (permission === "denied") {
                    showToast("알림 권한이 거부되었습니다.", "❌");
                }
            });
        }

        // Check & Update Notification Permission Banner
        function checkNotificationStatus() {
            const banner = document.getElementById('notif-banner');
            const title = document.getElementById('notif-status-title');
            const desc = document.getElementById('notif-status-desc');
            const btn = document.getElementById('notif-btn');

            if (!("Notification" in window)) {
                title.innerText = "웹 알림 미지원";
                desc.innerText = "화면 내 안내 메시지로 대체됩니다.";
                btn.classList.add('hidden');
                return;
            }

            if (Notification.permission === "granted") {
                banner.className = "mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-sm";
                title.innerText = "알림 설정이 준비되었습니다";
                title.className = "font-bold text-emerald-900";
                desc.innerText = "비 오는 날에 정해진 시간 맞춰 우산 알림을 보냅니다.";
                desc.className = "text-emerald-700";
                btn.classList.add('hidden');
            } else if (Notification.permission === "denied") {
                banner.className = "mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center justify-between shadow-sm";
                title.innerText = "알림 권한 차단됨";
                title.className = "font-bold text-rose-900";
                desc.innerText = "브라우저 주소창 차단해제로 알림을 허용해주세요.";
                desc.className = "text-rose-700";
                btn.classList.add('hidden');
            }
        }

        // Load data from LocalStorage or trigger setup view
        function loadSavedData() {
            const saved = localStorage.getItem('umbrella_weather_schedule');
            
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    const todayStr = getFormattedDate(new Date());
                    
                    if (parsed.length === 7 && parsed[0].dateStr === todayStr) {
                        weatherData = parsed;
                        showDashboardView();
                        return;
                    }
                } catch (e) {
                    console.error("Data parse error", e);
                }
            }

            initDefault7DaysData();
            showSetupView();
        }

        // Generate next 7 days default structure
        function initDefault7DaysData() {
            weatherData = [];
            const today = new Date();

            for (let i = 0; i < 7; i++) {
                const targetDate = new Date();
                targetDate.setDate(today.getDate() + i);

                weatherData.push({
                    dateStr: getFormattedDate(targetDate),
                    displayDate: `${targetDate.getMonth() + 1}/${targetDate.getDate()}`,
                    dayIndex: targetDate.getDay(),
                    dayName: DAY_NAMES[targetDate.getDay()],
                    isRain: false
                });
            }
        }

        // Render 7-day Setup Form
        function renderSetupForm() {
            const container = document.getElementById('weather-input-list');
            container.innerHTML = '';

            weatherData.forEach((item, index) => {
                const isWeekend = item.dayIndex === 0 || item.dayIndex === 6;
                const isToday = index === 0;

                const card = document.createElement('div');
                card.className = `p-3.5 rounded-2xl flex items-center justify-between border transition duration-200 ${
                    item.isRain 
                        ? 'bg-blue-50/90 border-blue-300 shadow-sm' 
                        : 'bg-white/80 border-slate-200 hover:border-slate-300'
                }`;

                card.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <span class="text-sm font-bold text-slate-800">
                            ${item.displayDate} <span class="text-xs text-slate-500 font-normal">(${item.dayName})</span>
                        </span>
                        ${isToday ? '<span class="text-[10px] bg-blue-600 text-white font-bold px-2 py-0.5 rounded-md">오늘</span>' : ''}
                        ${isWeekend ? '<span class="text-[10px] bg-slate-200 text-slate-600 font-medium px-1.5 py-0.5 rounded-md">주말</span>' : ''}
                    </div>

                    <button type="button" onclick="toggleRain(${index})" class="px-4 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition active:scale-95 ${
                        item.isRain 
                            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20' 
                            : 'bg-slate-100 text-slate-500 hover:bg-slate-200'
                    }">
                        <span>${item.isRain ? '🌧️ 비 옴 (우산)' : '☀️ 맑음'}</span>
                    </button>
                `;

                container.appendChild(card);
            });
        }

        function toggleRain(index) {
            weatherData[index].isRain = !weatherData[index].isRain;
            renderSetupForm();
        }

        function saveWeatherSchedule() {
            localStorage.setItem('umbrella_weather_schedule', JSON.stringify(weatherData));
            showToast("7일 날씨 설정이 저장되었습니다!", "💾");
            showDashboardView();
        }

        function showSetupView() {
            const todayStr = getFormattedDate(new Date());
            if (weatherData.length === 0 || weatherData[0].dateStr !== todayStr) {
                initDefault7DaysData();
            }

            document.getElementById('view-setup').classList.remove('hidden');
            document.getElementById('view-dashboard').classList.add('hidden');
            renderSetupForm();
        }

        function showDashboardView() {
            document.getElementById('view-setup').classList.add('hidden');
            document.getElementById('view-dashboard').classList.remove('hidden');
            renderDashboard();
        }

        // Render Dashboard UI
        function renderDashboard() {
            if (weatherData.length === 0) return;

            const today = weatherData[0];
            const todayCard = document.getElementById('today-card');
            const todayTitle = document.getElementById('today-weather-title');
            const todayIcon = document.getElementById('today-weather-icon');
            const todaySchedule = document.getElementById('today-notif-schedule');
            const todayDateText = document.getElementById('today-date-text');

            todayDateText.innerText = `TODAY (${today.displayDate} ${today.dayName}요일)`;

            const notifTimes = getNotificationTimes(today.dayIndex);

            if (today.isRain) {
                todayCard.className = "rounded-3xl p-6 shadow-xl text-white transition-all duration-300 bg-gradient-to-r from-blue-600 via-indigo-600 to-indigo-700 relative overflow-hidden";
                todayTitle.innerText = "오늘 비 소식이 있어요! ☂️";
                todayIcon.innerText = "🌧️";

                let scheduleHTML = `
                    <div class="flex justify-between items-center bg-white/10 p-2 rounded-xl">
                        <span>☀️ 등교 우산 알림:</span>
                        <span class="font-bold bg-white/20 px-2.5 py-0.5 rounded-lg">${notifTimes.morning}</span>
                    </div>
                `;

                if (notifTimes.afternoon) {
                    scheduleHTML += `
                        <div class="flex justify-between items-center bg-white/10 p-2 rounded-xl">
                            <span>🏫 하교 우산 알림:</span>
                            <span class="font-bold bg-white/20 px-2.5 py-0.5 rounded-lg">${notifTimes.afternoon} (${notifTimes.periodInfo})</span>
                        </div>
                    `;
                } else {
                    scheduleHTML += `
                        <div class="flex justify-between items-center bg-white/10 p-2 rounded-xl">
                            <span>🏫 하교 우산 알림:</span>
                            <span class="opacity-80">주말 (알림 없음)</span>
                        </div>
                    `;
                }

                todaySchedule.innerHTML = scheduleHTML;
            } else {
                todayCard.className = "rounded-3xl p-6 shadow-xl text-white transition-all duration-300 bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 relative overflow-hidden";
                todayTitle.innerText = "오늘은 비가 오지 않아요 ☀️";
                todayIcon.innerText = "☀️";
                todaySchedule.innerHTML = `
                    <p class="opacity-95 py-1 text-center font-medium">비 소식이 없으므로 오늘은 알림이 울리지 않습니다.</p>
                `;
            }

            // Render 7-day summary list
            const listContainer = document.getElementById('dashboard-schedule-list');
            listContainer.innerHTML = '';

            weatherData.forEach((item, index) => {
                const rules = getNotificationTimes(item.dayIndex);
                const row = document.createElement('div');
                row.className = `p-3 rounded-2xl flex items-center justify-between text-xs ${
                    index === 0 ? 'bg-blue-50/90 font-medium border border-blue-200' : 'bg-slate-50 border border-slate-100'
                }`;

                let timeInfo = "알림 없음";
                if (item.isRain) {
                    timeInfo = rules.afternoon 
                        ? `오전 ${rules.morning} / 오후 ${rules.afternoon}`
                        : `오전 ${rules.morning}`;
                }

                row.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <span class="font-bold w-14 text-slate-700">${item.displayDate} (${item.dayName})</span>
                        <span class="${item.isRain ? 'text-blue-600 font-bold' : 'text-amber-500 font-medium'}">
                            ${item.isRain ? '🌧️ 비 옴' : '☀️ 맑음'}
                        </span>
                    </div>
                    <span class="${item.isRain ? 'text-blue-700 bg-blue-100/80 px-2.5 py-1 rounded-lg font-bold' : 'text-slate-400'}">
                        ${timeInfo}
                    </span>
                `;

                listContainer.appendChild(row);
            });
        }

        // Helper: Notification rules by day of week
        function getNotificationTimes(dayIndex) {
            const morning = "08:00";
            let afternoon = null;
            let periodInfo = "";

            if (dayIndex === 1 || dayIndex === 4 || dayIndex === 5) {
                // Mon, Thu, Fri -> 6th period (15:00)
                afternoon = "15:00";
                periodInfo = "6교시 하교";
            } else if (dayIndex === 2 || dayIndex === 3) {
                // Tue, Wed -> 7th period (16:00)
                afternoon = "16:00";
                periodInfo = "7교시 하교";
            }

            return { morning, afternoon, periodInfo };
        }

        // Start background notification check loop
        function startNotificationScheduler() {
            setInterval(checkAndSendNotifications, 30000); // Checks every 30 seconds
        }

        function checkAndSendNotifications() {
            if (weatherData.length === 0) return;

            const now = new Date();
            const todayStr = getFormattedDate(now);
            const todayData = weatherData.find(item => item.dateStr === todayStr);

            if (!todayData || !todayData.isRain) return;

            const currentHHMM = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            const rules = getNotificationTimes(todayData.dayIndex);

            // Morning Check (08:00)
            if (currentHHMM === rules.morning) {
                triggerNotification(
                    "오늘 비가 와요! ☂️",
                    "등교 시 우산 꼭 챙겨서 학교로 가세요!"
                );
            }

            // Afternoon Check (15:00 or 16:00)
            if (rules.afternoon && currentHHMM === rules.afternoon) {
                triggerNotification(
                    "하교 시간입니다! 🌂",
                    "학교에 우산 두고 오지 말고 꼭 챙겨서 집으로 가세요!"
                );
            }
        }

        // Trigger Notification Handler
        function triggerNotification(title, body) {
            showToast(`${title} ${body}`, "☂️");

            if ("Notification" in window && Notification.permission === "granted") {
                try {
                    new Notification(title, {
                        body: body,
                        icon: "https://cdn-icons-png.flaticon.com/512/1163/1163624.png"
                    });
                } catch (e) {
                    console.log("Notification trigger error:", e);
                }
            }
        }

        // Manual Test Button Handler
        function testNotification(type) {
            if (type === 'morning') {
                triggerNotification(
                    "오늘 비가 와요! (등교 알림 테스트) ☂️",
                    "등교 시 우산 꼭 챙겨서 학교로 가세요!"
                );
            } else {
                triggerNotification(
                    "하교 시간입니다! (하교 알림 테스트) 🌂",
                    "학교에 우산 두고 오지 말고 꼭 챙겨서 집으로 가세요!"
                );
            }
        }

        // Toast Helper
        function showToast(message, icon = "ℹ️") {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            document.getElementById('toast-icon').innerText = icon;

            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 4000);
        }

        // Helper: Format Date YYYY-MM-DD
        function getFormattedDate(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
    </script>
</body>
</html>
